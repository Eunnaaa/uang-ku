{
  "name": "uangku",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "api:dev": "bun --cwd apps/api dev",
    "api:start": "bun --cwd apps/api start",
    "mobile:start": "bun --cwd apps/mobile start",
    "mobile:tunnel": "bun --cwd apps/mobile tunnel",
    "mobile:ios": "bun --cwd apps/mobile ios",
    "mobile:android": "bun --cwd apps/mobile android"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.3.14"
}
