# UangKu API Environment Configuration
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL 16 / Supabase PgBouncer)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/uangku

# Supabase Auth & JWT Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_SECRET=uangku-jwt-secret-key-development
