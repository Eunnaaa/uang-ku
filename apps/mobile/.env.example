# UangKu Mobile Environment Configuration
# Untuk pengujian di HP fisik dalam 1 jaringan Wi-Fi, ganti localhost dengan IP lokal komputer Anda (contoh: http://192.168.1.15:3001)
# Untuk produksi, gunakan domain HTTPS resmi backend (contoh: https://api.uangku.id)
EXPO_PUBLIC_API_URL=http://localhost:3001
